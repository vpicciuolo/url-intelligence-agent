{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vpicciuolo/url-intelligence-agent/hf-dataset/provenance-schema.json",
  "title": "URL Intelligence Provenance Consistency Benchmark Record",
  "type": "object",
  "required": ["schema_version", "track", "id", "predicate", "observations", "expected"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "track": { "const": "provenance-consistency" },
    "id": { "type": "string", "minLength": 1 },
    "predicate": { "type": "string", "minLength": 1 },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["representation", "layer", "raw_value"],
        "properties": {
          "representation": { "enum": ["http", "source_html", "rendered_dom", "external"] },
          "layer": { "enum": ["http_header", "html", "meta", "open_graph", "twitter_card", "json_ld", "microdata", "rdfa", "visible_dom", "sitemap", "feed", "api"] },
          "raw_value": {}
        },
        "additionalProperties": false
      }
    },
    "expected": {
      "type": "object",
      "properties": {
        "logical_conflict": { "type": "boolean" },
        "preferred_value": {},
        "relation": { "type": "string" },
        "minimum_observation_count": { "type": "integer", "minimum": 1 },
        "required_flags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
